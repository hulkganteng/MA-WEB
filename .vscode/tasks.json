{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel: Public Preview (port 8000)",
            "type": "shell",
            "command": "npm run preview:public",
            "isBackground": true,
            "problemMatcher": {
                "owner": "laravel-public-preview",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Building for production|vite v",
                    "endsPattern": "Server running on"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
